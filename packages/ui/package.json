{
  "name": "@repo/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles/variables.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:tokens && pnpm run build:ts",
    "build:tokens": "node ./style-dictionary.config.mjs",
    "build:ts": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "style-dictionary": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
