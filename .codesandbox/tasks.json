{
  "$schema": "https://codesandbox.io/schemas/tasks.json",
  "setupTasks": [
    {
      "name": "Install Dependencies",
      "command": "pnpm install"
    },
    {
      "name": "Build UI Library",
      "command": "turbo build --filter=@repo/ui"
    }
  ],
  "tasks": {
    "dev": {
      "name": "Development Server",
      "command": "turbo dev",
      "runAtStart": true,
      "preview": {
        "port": 3000
      }
    },
    "build": {
      "name": "Build All",
      "command": "turbo build"
    },
    "build:ui": {
      "name": "Build UI Library",
      "command": "turbo build --filter=@repo/ui"
    }
  }
}
