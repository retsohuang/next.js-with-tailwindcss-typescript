{
  "name": "monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @repo/ui build && pnpm --filter @repo/web dev",
    "build": "pnpm --filter @repo/ui build && pnpm --filter @repo/web build",
    "build:ui": "pnpm --filter @repo/ui build",
    "build:web": "pnpm --filter @repo/web build",
    "dev:web": "pnpm --filter @repo/web dev",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.1.0",
    "prettier": "^3.1.0"
  },
  "packageManager": "pnpm@8.10.0",
  "engines": {
    "node": ">=18"
  }
}
